{
  "name": "comptarag-frontend",
  "version": "1.0.0",
  "description": "ComptaRAG frontend: Angular chat UI for the agentic RAG assistant, IFRS and Tunisian fiscal law questions.",
  "license": "Apache-2.0",
  "scripts": {
    "start": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "watch": "ng build --watch --configuration development",
    "test": "jest",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:integration": "jest --testPathPattern=tests/integration",
    "test:coverage": "jest --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" --fix",
    "typecheck": "tsc -p tsconfig.spec.json --noEmit",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\" \"tests/**/*.ts\"",
    "prepare": "husky",
    "audit": "npm audit --omit=dev",
    "audit:full": "npm audit"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.5",
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/platform-browser-dynamic": "^21.2.19",
    "@angular/router": "^21.2.19",
    "firebase": "^12.18.0",
    "rxjs": "^7.8.1",
    "tslib": "^2.6.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.0.0",
    "@angular-eslint/builder": "^21.0.0",
    "@angular-eslint/schematics": "^21.0.0",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@playwright/test": "^1.48.0",
    "@testing-library/angular": "^19.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/user-event": "^14.6.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.2.0",
    "angular-eslint": "^21.0.0",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.6",
    "jest": "^30.0.0",
    "jest-environment-jsdom": "^30.0.0",
    "jest-preset-angular": "^17.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{html,scss,json,md}": [
      "prettier --write"
    ]
  },
  "overrides": {
    "sockjs": {
      "uuid": "^11.1.1"
    }
  }
}
